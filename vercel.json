{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "zuragchin.mn" }],
      "destination": "https://www.zuragchin.mn/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "zuragchin.mn" }],
      "destination": "https://www.zuragchin.mn/:path*",
      "statusCode": 301
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/(favicon\\.ico|favicon\\.svg|favicon-32\\.png|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|og-image\\.png|site\\.webmanifest|robots\\.txt|sitemap\\.xml)$", "dest": "/$1" },
    { "src": "^/(.*\\.(?:js|css|map|png|svg|ico|webp|txt|xml|webmanifest|json|woff2?))$", "dest": "/$1" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/explore/?$", "dest": "/explore.html" },
    { "src": "^/photographers/?$", "dest": "/photographers.html" },
    { "src": "^/studios/?$", "dest": "/studios.html" },
    { "src": "^/studios/new/?$", "dest": "/app.html" },
    { "src": "^/studios/mine/?$", "dest": "/app.html" },
    { "src": "^/studios/[^/]+/edit/?$", "dest": "/app.html" },
    { "src": "^/studios/[^/]+/?$", "dest": "/app.html" },
    { "src": "^/listings/?$", "dest": "/listings.html" },
    { "src": "^/ai-booth/?$", "dest": "/ai-booth.html" },
    { "src": "^/terms/?$", "dest": "/terms.html" },
    { "src": "^/privacy/?$", "dest": "/privacy.html" },
    { "src": "^/contact/?$", "dest": "/contact.html" },
    { "src": "^/auth/login/?$", "dest": "/auth/login.html" },
    { "src": "^/auth/register/?$", "dest": "/auth/register.html" },
    { "src": "^/auth/forgot-password/?$", "dest": "/auth/forgot-password.html" },
    { "src": "^/auth/reset-password/?$", "dest": "/app.html" },
    { "src": "^/photographers/[^/]+/?$", "dest": "/app.html" },
    { "src": "^/album/[^/]+/screen/?$", "dest": "/app.html" },
    { "src": "^/album/[^/]+/?$", "dest": "/app.html" },
    { "src": "^/receipt/[^/]+/?$", "dest": "/app.html" },
    { "src": "^/offer/[^/]+/?$", "dest": "/app.html" },
    { "src": "^/booth/r/[^/]+/?$", "dest": "/app.html" },
    { "src": "^/booth/[^/]+/?$", "dest": "/app.html" },
    { "src": "^/dashboard(?:/.*)?$", "dest": "/app.html" },
    { "src": "^/admin/?$", "dest": "/app.html" },
    { "src": "^/albums/?$", "dest": "/app.html" },
    { "src": "^/my-purchases/?$", "dest": "/app.html" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}
